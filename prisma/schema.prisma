generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector, pg_graphql, pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp"), ltree, pgrouting, postgis]
}

enum CharacterProfileField {
  NAME
  APPEARANCE
  BACKSTORY
  PERSONALITY_TRAITS
  IDEALS
  BONDS
  FLAWS
}

enum CharacterChangeSource {
  PLAYER
  AI_PROPOSAL
  PDF_IMPORT
  UNDO
}

enum CharacterProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  STALE
  EXPIRED
}

enum CharacterProposalValidationStatus {
  VALID
  REJECTED
}

model Zone {
  id          String @id @default(cuid())
  encounterId String
  name        String
  x           Int    @default(0)
  y           Int    @default(0)

  encounter  Encounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@unique([encounterId, x, y])
  @@index([encounterId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  characters Character[]
  campaigns  Campaign[]
}

model Character {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  race                 String
  class                String
  level                Int      @default(1)
  hp                   Int
  maxHp                Int
  stats                Json
  spellSlots           Json?
  /// SRD skills the character is proficient in, as a JSON array of skill names
  /// (e.g. ["Athletics","Perception"]). Seeded from the class at creation.
  /// Null or malformed means no proficiency; it never grants an unearned bonus.
  skillProficiencies   Json?
  xp                   Int      @default(0)
  /// The ID of the spell currently being concentrated on. Null = no active concentration.
  concentrationSpellId String?
  /// Total hit dice the character possesses (= level). Equals the number of
  /// hit dice available at full rest. Decremented by short rest healing.
  hitDiceTotal         Int      @default(1)
  /// Remaining hit dice available for short rest healing.
  /// Reset to hitDiceTotal on long rest. Must satisfy 0 ≤ remaining ≤ total.
  hitDiceRemaining     Int      @default(1)
  /// Persisted D&D 5e 2014 Exhaustion level. Range: 0 (none) to 6 (dead).
  /// Increments must originate from authoritative 5e mechanics only;
  /// executeExplorationTurn no longer increments it (the exploration rest-cycle
  /// trigger was non-canonical and has been retired).
  /// Decremented by 1 on long rest per 5e 2014 rules.
  exhaustionLevel      Int      @default(0)
  /// Monotonic revision used for optimistic concurrency on character-sheet writes.
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  user            User                      @relation(fields: [userId], references: [id])
  campaigns       Campaign[]
  inventory       InventoryItem[]
  profile         CharacterProfile?
  changeAudits    CharacterChangeAudit[]
  changeProposals CharacterChangeProposal[]

  @@index([userId], map: "Character_userId_idx")
}

/// Player-authored narrative data. Mechanical state remains on Character and domain entities.
model CharacterProfile {
  id                String   @id @default(cuid())
  characterId       String   @unique
  appearance        String   @default("")
  backstory         String   @default("")
  personalityTraits String   @default("")
  ideals            String   @default("")
  bonds             String   @default("")
  flaws             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

/// Immutable record of an applied sheet change. Undo creates another event.
model CharacterChangeAudit {
  id             String                @id @default(cuid())
  characterId    String
  actorUserId    String
  field          CharacterProfileField
  previousValue  Json
  newValue       Json
  source         CharacterChangeSource
  reason         String?
  revisionBefore Int
  revisionAfter  Int
  proposalId     String?
  idempotencyKey String
  createdAt      DateTime              @default(now())

  character Character                @relation(fields: [characterId], references: [id], onDelete: Cascade)
  proposal  CharacterChangeProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@unique([actorUserId, idempotencyKey])
  @@index([characterId, createdAt])
  @@index([proposalId])
}

/// Untrusted AI/PDF output held for validation and explicit player confirmation.
model CharacterChangeProposal {
  id                         String                            @id @default(cuid())
  characterId                String
  actorUserId                String
  expectedVersion            Int
  reason                     String
  changes                    Json
  previousValues             Json
  validationStatus           CharacterProposalValidationStatus
  warnings                   String[]                          @default([])
  requiresPlayerConfirmation Boolean                           @default(true)
  status                     CharacterProposalStatus           @default(PENDING)
  source                     CharacterChangeSource
  idempotencyKey             String
  decisionIdempotencyKey     String?
  createdAt                  DateTime                          @default(now())
  expiresAt                  DateTime
  decidedAt                  DateTime?

  character   Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  auditEvents CharacterChangeAudit[]

  @@unique([actorUserId, idempotencyKey])
  @@unique([actorUserId, decisionIdempotencyKey])
  @@index([characterId, status, createdAt])
}

model Campaign {
  id                String   @id @default(cuid())
  userId            String
  characterId       String
  title             String
  status            String   @default("active")
  /// Party gold pieces. Integer — no fractional currency.
  /// Mutations ONLY via Prisma transactions from tool execution, never from AI narration.
  gold              Int      @default(0)
  /// The location the party is currently exploring. Null = no active exploration.
  currentLocationId String?
  /// The specific node within the location the party occupies. Null = not in a location.
  currentNodeId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  character       Character     @relation(fields: [characterId], references: [id])
  logs            GameLog[]
  encounters      Encounter[]
  memories        MemoryEntry[]
  quests          Quest[]
  npcs            NPC[]
  locations       Location[]    @relation("CampaignLocations")
  currentLocation Location?     @relation("CampaignCurrentLocation", fields: [currentLocationId, id], references: [id, campaignId], onDelete: Restrict, onUpdate: Cascade)
  currentNode     LocationNode? @relation("CampaignCurrentNode", fields: [currentNodeId, currentLocationId], references: [id, locationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId], map: "Campaign_userId_idx")
  @@index([characterId], map: "Campaign_characterId_idx")
}

model GameLog {
  id         String   @id @default(cuid())
  campaignId String
  role       String
  content    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId], map: "GameLog_campaignId_idx")
}

model Encounter {
  id               String   @id @default(cuid())
  campaignId       String
  status           String   @default("active")
  // "active" | "resolved" | "fled"
  round            Int      @default(1)
  currentTurnIndex Int      @default(0)
  // Zero-based index into combatants ordered by initiativeTotal DESC.
  totalDamageDealt Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  combatants Combatant[]
  zones      Zone[]

  @@index([campaignId], map: "Encounter_campaignId_idx")
}

model Combatant {
  id                   String  @id @default(cuid())
  encounterId          String
  name                 String
  isPlayer             Boolean @default(false)
  hp                   Int
  maxHp                Int
  ac                   Int     @default(10)
  initiativeTotal      Int
  stats                Json    @default("{}")
  conditions           Json    @default("[]")
  // String[] of active condition names, e.g. ["Prone", "Poisoned"].
  /// SRD damage modifiers, snapshotted from the monster at spawn. Same names
  /// and shapes as SrdMonster's, so no reader has to translate between them.
  /// Empty for the player: no rule in this codebase grants a player resistance.
  damageImmunities      String[] @default([])
  damageResistances     String[] @default([])
  damageVulnerabilities String[] @default([])
  /// The ID of the spell currently being concentrated on. Null = no active concentration.
  concentrationSpellId String?
  size                 String  @default("Medium")
  zoneId               String?
  /// Successful death saves accumulated while the combatant is at 0 hit points.
  deathSaveSuccesses   Int     @default(0)
  /// Failed death saves accumulated while the combatant is at 0 hit points.
  deathSaveFailures    Int     @default(0)
  /// Per-turn action economy, owned by the combat rules engine.
  /// The column is nullable for pre-action-budget combatants.
  actionBudget         Json?
  /// Precise grid column (0-based). Relative to the encounter's global space.
  x                    Int     @default(0)
  /// Precise grid row (0-based). Relative to the encounter's global space.
  y                    Int     @default(0)
  /// Backend-authorized XP snapshot, fixed once at encounter creation (docs/DECISION_XP_AWARD_AUTHORITY.md §5).
  /// NULL = no authorized source (unavailable). Distinct from 0, which is a legitimate CR-0 award.
  /// Never populated from the client request or from AI narration.
  xpValue              Int?

  encounter Encounter @relation(fields: [encounterId], references: [id])
  zone      Zone?     @relation(fields: [zoneId], references: [id])

  @@index([encounterId])
  @@index([encounterId, zoneId])
  @@index([zoneId], map: "Combatant_zoneId_idx")
}

model InventoryItem {
  id           String  @id @default(cuid())
  characterId  String
  name         String
  type         String
  // "weapon" | "armor" | "consumable" | "spell" | "misc"
  quantity     Int     @default(1)
  properties   Json
  /// Equipped slot name, e.g. 'MAIN_HAND' | 'OFF_HAND' | 'ARMOR' | 'ACCESSORY'.
  /// Null means the item is in the bag but not equipped.
  equippedSlot String?
  /// Canonical SRD slug reference
  indexSlug    String?

  character Character @relation(fields: [characterId], references: [id])

  @@index([characterId], map: "InventoryItem_characterId_idx")
}

model MemoryEntry {
  id         String                      @id @default(cuid())
  campaignId String
  /// Human-readable memory text injected into prompts. Max ~400 chars.
  content    String
  /// 1536-dimensional embedding from text-embedding-3-small.
  /// Stored as Unsupported until Prisma ships a native Vector scalar.
  embedding  Unsupported("vector(1536)")
  /// The production HNSW cosine index is raw-SQL managed because Prisma does
  /// not model HNSW indexes. Do not remove it from the database through a diff.
  /// Relative importance weight; higher values surface this memory first.
  importance Float                       @default(1.0)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model Quest {
  id          String   @id @default(cuid())
  campaignId  String
  title       String
  description String
  status      String   @default("active")
  // "active" | "completed" | "failed"
  /// Seed of the NPC who issued this quest. Null for quests without a named giver.
  giverId     String?
  /// Primary location the quest takes place in or leads to.
  location    String?
  /// Narrative hook — the inciting detail that draws the party in.
  hook        String?
  /// The specific objective the party must accomplish.
  objective   String?
  /// What the party stands to gain on completion.
  reward      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId], map: "Quest_campaignId_idx")
}

model NPC {
  id                   String   @id @default(cuid())
  campaignId           String
  /// Stable generator seed — deterministically reproduces the full statblock
  /// via generateNPC(seed, role). Never changes after creation.
  seed                 String
  /// Archetype used for statblock generation: "guard" | "bandit" | "commoner"
  role                 String
  /// Denormalized from generateNPC — stored for fast display and HP-bar rendering.
  name                 String
  maxHp                Int
  /// Mutable. Callers decrement this when damage is applied.
  hp                   Int
  /// Armor class — denormalized from the deterministic statblock.
  ac                   Int
  /// Free-form DM notes: story beats, attitudes, plot ties, last seen location.
  notes                String   @default("")
  /// Creature race, e.g. "human", "elf", "dwarf". Null for legacy records.
  race                 String?
  /// Mundane profession, e.g. "blacksmith", "soldier". Null for legacy records.
  profession           String?
  /// Moral alignment, e.g. "lawful good", "chaotic neutral". Null for legacy records.
  alignment            String?
  /// Six ability scores: { STR, DEX, CON, INT, WIS, CHA }. Null for legacy records.
  abilityScores        Json?
  /// Personality traits { personality, ideal, bond, flaw }. Null for legacy records.
  traits               Json?
  /// Current disposition toward the party. Range: −10 (Hostile) to +10 (Helpful).
  /// Set by rollReaction on first meeting; updated by socialCheck on social actions.
  /// Null for NPCs the party has never spoken to (legacy reaction roll pending).
  disposition          Int?
  /// Personality Tags generated deterministically from the seed.
  /// JSON object: { motivation: string, secret: string, distinctiveTrait: string }
  /// Populated by generateNPCPersonality(seed) on first interaction.
  /// Never null after first meeting; null for legacy/unmet NPCs.
  personalityTags      Json?
  /// True once the party has formally met this NPC (rollReaction has fired).
  /// Prevents duplicate legacy reaction rolls on subsequent encounters.
  hasMetPlayer         Boolean  @default(false)
  knownRumors          String[] @default([])
  /// The ID of the spell currently being concentrated on. Null = no active concentration.
  concentrationSpellId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  /// One NPC seed is unique per campaign — UPSERT key.
  @@unique([campaignId, seed])
  @@index([campaignId])
}

model SrdMonster {
  id                    String   @id
  name                  String
  /// Canonical SRD slug/index, e.g. "adult-red-dragon".
  indexSlug             String?
  /// Challenge Rating as a float (0.125, 0.25, 0.5, 1–30). Null for legacy records.
  cr                    Float?
  /// Creature type, e.g. "dragon", "undead", "humanoid", "beast".
  type                  String?
  /// Creature subtype, if present in source data.
  subtype               String?
  /// Size category: "Tiny" | "Small" | "Medium" | "Large" | "Huge" | "Gargantuan".
  size                  String?
  /// Alignment string, e.g. "lawful evil", "any alignment", "unaligned".
  alignment             String?
  /// XP reward for defeating the creature.
  xp                    Int?
  /// Monster proficiency bonus (derived in SRD block).
  proficiencyBonus      Int?
  /// Canonical HP and hit dice from SRD.
  hitPoints             Int?
  hitDice               String?
  /// Flattened AC primary value from armor_class.
  armorClass            Int?
  /// Human-readable speed block (raw text/JSON stringified).
  speed                 String?
  /// Human-readable languages field.
  languages             String?
  /// Ability scores (if present).
  strength              Int?
  dexterity             Int?
  constitution          Int?
  intelligence          Int?
  wisdom                Int?
  charisma              Int?
  /// Quick filter flags inferred from abilities/actions payloads.
  hasLegendaryActions   Boolean?
  hasSpellcasting       Boolean?
  /// Resistance/immunity vectors for fast filtering.
  damageImmunities      String[] @default([])
  damageResistances     String[] @default([])
  damageVulnerabilities String[] @default([])
  conditionImmunities   String[] @default([])
  /// Full raw JSON blob from the SRD dataset.
  data                  Json

  @@index([cr])
  @@index([type])
  @@index([size])
  @@index([alignment])
  @@index([indexSlug])
  @@index([hasSpellcasting])
  @@index([damageImmunities], type: Gin, map: "SrdMonster_damageImmunities_gin")
  @@index([damageResistances], type: Gin, map: "SrdMonster_damageResistances_gin")
  @@index([damageVulnerabilities], type: Gin, map: "SrdMonster_damageVulnerabilities_gin")
  @@index([conditionImmunities], type: Gin, map: "SrdMonster_conditionImmunities_gin")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "SrdMonster_name_trgm_idx")
}

model SrdSpell {
  id              String   @id
  name            String
  /// Canonical SRD slug/index, e.g. "magic-missile".
  indexSlug       String?
  level           Int?
  /// Spell school index, e.g. "evocation".
  school          String?
  castingTime     String?
  range           String?
  duration        String?
  ritual          Boolean?
  concentration   Boolean?
  attackType      String?
  /// damage.damage_type.index when present.
  damageType      String?
  /// dc.dc_type.index when present.
  saveAbility     String?
  /// True when the spell includes healing scaling/data.
  hasHealing      Boolean?
  hasAreaOfEffect Boolean?
  /// Class and component vectors for filtering.
  classes         String[] @default([])
  components      String[] @default([])
  data            Json

  @@index([level])
  @@index([school])
  @@index([ritual])
  @@index([concentration])
  @@index([attackType])
  @@index([damageType])
  @@index([saveAbility])
  @@index([classes], type: Gin, map: "SrdSpell_classes_gin")
  @@index([components], type: Gin, map: "SrdSpell_components_gin")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "SrdSpell_name_trgm_idx")
}

model SrdItem {
  id   String @id
  name String
  data Json
}

/// A D&D 5e 2014 SRD condition seeded from dnd5eapi /api/2014/conditions.
/// The AI narrator MUST NOT apply conditions not present in this table.
/// Condition mutations on Combatant.conditions are validated against this table
/// at the rules-engine layer before any DB write.
model SrdCondition {
  id        String  @id
  name      String
  /// Canonical SRD slug, e.g. "blinded". Lowercase-kebab, unique.
  indexSlug String  @unique
  /// Concatenated desc paragraphs from the SRD, joined by newline.
  desc      String?
  /// Full raw JSON payload from dnd5eapi — source of truth.
  data      Json

  @@index([indexSlug])
}

model SrdEquipment {
  id                  String   @id
  name                String
  indexSlug           String?
  equipmentCategory   String?
  weaponCategory      String?
  weaponRange         String?
  categoryRange       String?
  costQuantity        Int?
  costUnit            String?
  weight              Float?
  damageDice          String?
  damageType          String?
  twoHandedDamageDice String?
  twoHandedDamageType String?
  rangeNormal         Int?
  rangeLong           Int?
  armorCategory       String?
  armorClassBase      Int?
  armorClassDexBonus  Boolean?
  armorClassMaxBonus  Int?
  strMinimum          Int?
  stealthDisadvantage Boolean?
  desc                String?
  properties          String[] @default([])
  data                Json

  @@index([indexSlug])
  @@index([equipmentCategory])
  @@index([weaponCategory])
  @@index([armorCategory])
}

/// A procedurally generated location — a tavern, village, dungeon floor, etc.
/// Created exclusively by the `generateLocation` tool; the AI narrator may NOT
/// invent locations outside this table.
model Location {
  id          String   @id @default(cuid())
  campaignId  String
  /// Deterministic seed — the same seed always reproduces the same layout.
  seed        String
  /// Location archetype: "tavern" | "village" | "dungeon" | "wilderness" | "ruins"
  type        String
  /// Human-readable evocative name, e.g. "The Dripping Nave"
  name        String
  /// 1–3 sentence atmospheric description.
  description String
  /// Optional parent — e.g. a dungeon floor's parent is the dungeon entrance.
  parentId    String?
  createdAt   DateTime @default(now())

  campaign            Campaign       @relation("CampaignLocations", fields: [campaignId], references: [id])
  currentForCampaigns Campaign[]     @relation("CampaignCurrentLocation")
  parent              Location?      @relation("LocationHierarchy", fields: [parentId, campaignId], references: [id, campaignId], onDelete: Restrict, onUpdate: Cascade)
  children            Location[]     @relation("LocationHierarchy")
  nodes               LocationNode[]
  edges               LocationEdge[]

  @@unique([campaignId, seed])
  @@unique([id, campaignId], map: "Location_id_campaignId_key")
  @@index([campaignId])
}

/// A single room, area, or zone within a Location.
/// Part of the node graph that players navigate.
model LocationNode {
  id          String  @id @default(cuid())
  locationId  String
  /// Index within the generated graph (0 = entry node).
  index       Int
  /// Evocative name, e.g. "The Whispering Gallery"
  name        String
  /// Brief atmospheric description (≤ 300 chars).
  description String
  /// Feature tag: "empty" | "npc" | "hazard" | "treasure" | "quest_hook" | "rest" | "shop" | "exit"
  feature     String  @default("empty")
  /// Optional NPC seed — links to NPC generation for this node's inhabitant.
  npcSeed     String?
  /// Optional extra feature data (hazard details, shop inventory hints, etc.)
  featureData Json    @default("{}")
  /// Grid position for visual rendering (column, 0-based).
  x           Int
  /// Grid position for visual rendering (row, 0-based).
  y           Int

  location            Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  currentForCampaigns Campaign[]     @relation("CampaignCurrentNode")
  edgesFrom           LocationEdge[] @relation("EdgeFrom")
  edgesTo             LocationEdge[] @relation("EdgeTo")

  @@unique([locationId, index])
  @@unique([id, locationId], map: "LocationNode_id_locationId_key")
  @@index([locationId])
}

/// An edge connecting two LocationNodes — defines navigable passages.
/// Edges are bidirectional: if A→B exists, B→A is implicit.
model LocationEdge {
  id          String @id @default(cuid())
  locationId  String
  fromNodeId  String
  toNodeId    String
  /// Passage type: "open" | "door" | "locked" | "hidden" | "collapsed"
  passageType String @default("open")

  location Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fromNode LocationNode @relation("EdgeFrom", fields: [fromNodeId, locationId], references: [id, locationId], onDelete: Cascade, onUpdate: Cascade)
  toNode   LocationNode @relation("EdgeTo", fields: [toNodeId, locationId], references: [id, locationId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([locationId])
}
