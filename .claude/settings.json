{
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm generate:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Skill(update-config)",
      "Skill(commit-commands:commit)",
      "Bash(npx prisma:*)",
      "Bash(pnpm prisma:*)",
      "Bash(pnpm exec:*)"
    ],
    "deny": [
      "Bash(prisma migrate reset:*)",
      "Bash(* prisma migrate reset:*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(* prisma migrate deploy:*)",
      "Bash(prisma migrate dev:*)",
      "Bash(* prisma migrate dev:*)",
      "Bash(prisma migrate resolve:*)",
      "Bash(* prisma migrate resolve:*)",
      "Bash(prisma db push:*)",
      "Bash(* prisma db push:*)",
      "Bash(prisma db seed:*)",
      "Bash(* prisma db seed:*)",
      "Bash(prisma db execute:*)",
      "Bash(* prisma db execute:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(node:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm exec tsc --noEmit 2>&1 | tail -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json,os; inp=sys.stdin.read(); p=json.loads(inp).get('file_path','') if inp.strip() else ''; blocked='.env' in os.path.basename(p) and not p.endswith('.example'); sys.exit(1) if blocked else sys.exit(0)\" <<< \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ]
  }
}
