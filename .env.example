DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dungeon_cortex_dev"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/dungeon_cortex_dev"

# Private mode (safe default: false). Without the literal value "true", the
# app fails closed and refuses to resolve any user. Setting this to "true"
# enables single-user private mode only, which is NOT authentication and does
# NOT provide multi-user isolation. Never enable this in a public deployment.
PRIVATE_MODE_ENABLED=false

# OpenAI (optional in local development; required in production for real AI narration and embeddings)
OPENAI_API_KEY=""

# Supabase Auth (transitional and currently inactive until real auth wiring exists)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
